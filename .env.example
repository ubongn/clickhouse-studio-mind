# Copy to .env and fill in. NEVER commit the real .env.

# --- LLM provider (Google) ---
# Gemini API key from aistudio.google.com (development setup).
# TODO(GCP): when running on Google Cloud, set PROVIDER=vertex and configure
# GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION instead of an API key.
# The provider layer in studio_mind/llm.py swaps automatically.
PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# --- Vertex AI (Google Cloud, production path) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- ClickHouse ---
# Any ClickHouse works: local server, WSL, or ClickHouse Cloud.
# NOTE: the runtime path (below) speaks to the NATIVE port; the HTTP port in
# CLICKHOUSE_URL is remapped automatically (8123→9000, 8443→9440-secure).
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=studio

# --- Transport (compliance) ---
# mcp (default): runtime queries go through the OFFICIAL mcp-clickhouse
#   server — github.com/ClickHouse/mcp-clickhouse (pip: clickhouse-mcp-server),
#   spawned as a stdio subprocess, read-only session.
# http: dev fallback — direct clickhouse-connect client, no MCP layer.
# The bulk loader always uses clickhouse-connect regardless of this setting.
STUDIO_MIND_TRANSPORT=mcp

# --- Data generation ---
GENERATOR_ROWS=50000000
GENERATOR_SEED=20260826
